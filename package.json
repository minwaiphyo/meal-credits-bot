{
  "name": "intern-meal-credits-leaderboard",
  "version": "1.0.0",
  "description": "Telegram bot for HMGICS intern meal credits leaderboard.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:railway": "prisma migrate deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "keywords": [
    "telegram",
    "grammy",
    "prisma",
    "ocr",
    "tesseract"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@grammyjs/hydrate": "^1.4.1",
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.34.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "prisma": "^6.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
